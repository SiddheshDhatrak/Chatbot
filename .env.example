# Copy to .env and fill in. Never commit .env.

# SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Primary LLM provider
GROQ_API_KEY=""
# Optional model override
GROQ_MODEL="openai/gpt-oss-120b"

# Optional key for the Pollinations fallback (keyless endpoint used if empty)
POLLINATIONS_API_KEY=""

# NEXORA web_search tool (https://tavily.com)
TAVILY_API_KEY=""
# NEXORA agent limits
NEXORA_MAX_STEPS=8
NEXORA_MAX_TOKENS=40000