// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id        String    @id @default(cuid())
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  runs      Run[]

  @@index([updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ---------- NEXORA research agent ----------

model Run {
  id                String    @id @default(cuid())
  sessionId         String
  question          String
  status            String    @default("running") // "running" | "completed" | "step_limit" | "error"
  model             String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  totalLatencyMs    Int?
  totalSteps        Int       @default(0)
  totalToolCalls    Int       @default(0)
  totalTokens       Int?
  usedFallback      Boolean   @default(false)
  finalAnswer       String?
  citationPrecision Float?
  session           Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  steps             Step[]
  notes             Note[]
  sources           Source[]

  @@index([sessionId, startedAt])
}

model Step {
  id          String   @id @default(cuid())
  runId       String
  stepNo      Int
  tool        String
  argsJson    String
  observation String
  error       Boolean  @default(false)
  latencyMs   Int
  createdAt   DateTime @default(now())
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stepNo])
}

model Note {
  id        String   @id @default(cuid())
  runId     String
  title     String
  content   String
  sourceUrl String?
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model Source {
  id          String   @id @default(cuid())
  runId       String
  index       Int      // citation number [n]
  url         String
  title       String?
  retrievedAt DateTime @default(now())
  wasRead     Boolean  @default(false)
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@index([runId])
}
